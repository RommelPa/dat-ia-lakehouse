# Aplicación
#APP_ENV=test

# Backend de consultas: postgres | databricks
QUERY_BACKEND=postgres

# Base de datos PostgreSQL/Supabase
DATABASE_URL=""

# Databricks SQL (solo si QUERY_BACKEND=databricks)
DATABRICKS_SERVER_HOSTNAME=""
DATABRICKS_HTTP_PATH=""
DATABRICKS_CATALOG="dat_ia"
DATABRICKS_SCHEMA="gold"
DATABRICKS_AUTH_TYPE="databricks-oauth"

# Gemini
GOOGLE_API_KEY=""

# Cloudflare Workers AI (opcional)
USE_CLOUDFLARE_LLM=false
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_KEY=""

# Chroma remoto (opcional; sin CHROMA_HOST se usa ./chroma_db)
# CHROMA_HOST=""
# CHROMA_PORT=8000

# LangSmith (opcional)
USE_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""

# Sobrescrituras opcionales; los valores predeterminados son dat_ia_test y 1.0.
# LANGSMITH_PROJECT=dat_ia_prd
